# ============================================================
# Santinela — environment configuration
# Copy to `.env` and fill in. NEVER commit `.env`.
# ============================================================

# --- Trading mode gate (S11) ---------------------------------
# "dry" (default, paper trading) or "live".
# Live additionally requires user_data/config.live.json and the
# interactive go-live gate (`make live`). Setting this alone is
# NOT enough to trade real money — by design.
TRADING_MODE=dry

# --- Anthropic (LLM Strategist) ------------------------------
ANTHROPIC_API_KEY=
STRATEGIST_MODEL=claude-sonnet-4-6

# --- Exchange (CCXT id: kraken | okx | bybit) ----------------
# Keys must be TRADE-ONLY: withdrawals DISABLED, IP-whitelisted (S9).
# Dry-run works without keys (public endpoints only).
EXCHANGE_ID=kraken
EXCHANGE_KEY=
EXCHANGE_SECRET=

# --- Telegram -------------------------------------------------
# Set TELEGRAM_ENABLED=true only after filling token + chat id.
TELEGRAM_ENABLED=false
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# --- Freqtrade REST API (internal, used by the brain service) -
# Bound to 127.0.0.1 on the host; change the password anyway.
FT_API_USERNAME=santinela
FT_API_PASSWORD=change-me-please
FT_JWT_SECRET=change-me-please-too
FT_WS_TOKEN=change-me-as-well

# --- Timezone for the daily report ----------------------------
TZ=Europe/Bucharest
